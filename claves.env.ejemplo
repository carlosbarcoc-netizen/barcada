# Barcada · tus claves. Copia este archivo como «claves.env» y pega cada clave después del «=».
# Nunca compartas claves.env ni lo subas a internet.

# La voz (obligatoria para la voz real): elevenlabs.io → Desarrolladores → Claves de API (sin restricciones)
ELEVENLABS_API_KEY=pega_aqui_tu_clave

# Solo para el estilo realista (opcional; el 2D no las necesita): una de las dos.
# fal.ai (recomendado, FLUX): fal.ai → Dashboard → Keys
FAL_KEY=pega_aqui_tu_clave
# u OpenAI (gpt-image-1): platform.openai.com → API keys
OPENAI_API_KEY=pega_aqui_tu_clave

