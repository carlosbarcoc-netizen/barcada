# Barco Viral · tus claves. Copia este archivo como «claves.env» y pega cada clave después del «=».
# Nunca compartas claves.env ni lo subas a internet.

# La voz (obligatoria para la voz real): elevenlabs.io → Desarrolladores → Claves de API (sin restricciones)
ELEVENLABS_API_KEY=pega_aqui_tu_clave

# Las imágenes realistas: una de las dos.
# fal.ai (recomendado, FLUX): fal.ai → Dashboard → Keys
FAL_KEY=pega_aqui_tu_clave
# u OpenAI (gpt-image-1): platform.openai.com → API keys
OPENAI_API_KEY=pega_aqui_tu_clave

# Fotos y clips GRATIS (opcional, recomendado): con una basta.
# Pixabay (recomendado): inicia sesión en pixabay.com y abre pixabay.com/api/docs → tu clave sale en verde (gratis)
PIXABAY_API_KEY=pega_aqui_tu_clave
# Pexels: solo si ya tienes clave (pexels.com/api; a veces pausan las claves nuevas)
PEXELS_API_KEY=pega_aqui_tu_clave
